---
const bg = [
  'bg-[linear-gradient(150deg,oklch(0.4600_0.1900_264)_0%,oklch(0.3400_0.1500_285)_100%)]',
  'bg-[linear-gradient(150deg,oklch(0.2178_0.0552_256.09)_0%,oklch(0.4200_0.1750_262)_100%)]',
  'bg-[linear-gradient(150deg,rgb(122_90_34)_0%,oklch(0.2900_0.1050_260)_100%)]',
  'bg-[linear-gradient(150deg,oklch(0.3600_0.0800_230)_0%,oklch(0.5000_0.1750_255)_100%)]',
];
const items = [
  { name: 'Cris', role: 'Aluna do Fluent Speech', img: 'cris', size: 600, alt: 'Foto de Cris, aluna do fluent speech', quote: "“Meu inglês evoluiu muito. Hoje me sinto mais confiante para falar e consigo usar palavras e expressões do dia a dia com mais naturalidade. As aulas são leves, dinâmicas e fazem a diferença.”" },
  { name: 'Glici', role: 'Aluna do Fluent Speech', img: 'glici', size: 600, alt: 'Foto de Glici, aluna do fluent speech', quote: "“Um método envolvente, aulas dinâmicas e uma evolução que realmente pode ser percebida. Aprender inglês ficou muito mais leve e motivador.”" },
  { name: 'Marcos', role: 'Aluno do Fluent Speech', img: 'marcos', size: 512, alt: 'Foto de Marcos, aluno do fluent speech', quote: "“Hoje já consigo compreender melhor textos em inglês, ler e-mails com muito mais confiança e perceber uma evolução real no meu aprendizado. O curso tornou o inglês muito mais acessível pra mim.”" },
  { name: 'Letícia', role: 'Aluna do Fluent Speech', img: 'leticia', size: 600, alt: 'Foto de Letícia, aluna do fluent speech', quote: "“O método deixou o inglês mais simples e prático. Consigo estudar sem complicação e aplicar o que aprendo no meu dia a dia.”" },
  { name: "Sabrina Polezzi", role: "Aluna do Fluent Speech", img: "depoimentos/sabrina-polezzi", size: 360, alt: "Foto de Sabrina Polezzi, aluna do fluent speech", quote: "“Tenho que compartilhar com você, esta semana participei de uma reunião em inglês e entendi 85%, e falei também.”" },
  { name: "Paloma Noronha", role: "Aluna do Fluent Speech", img: "depoimentos/paloma-noronha", size: 360, alt: "Foto de Paloma Noronha, aluna do fluent speech", quote: "“Me sinto muito compreendida em minhas dificuldades e dúvidas, não fico com vergonha de falar e errar as palavras.”" },
  { name: "Cris", role: "Aluna do Fluent Speech", img: "depoimentos/cris", size: 360, alt: "Foto de Cris, aluna do fluent speech", quote: "“Além da Nájila ser super profissional, é paciente, amorosa e também é muito divertida. Isso torna as aulas mais leves, animadas e empolgantes.”" },
  { name: "Cintia Henrique", role: "Aluna do Fluent Speech", img: "depoimentos/cintia-henrique", size: 360, alt: "Foto de Cintia Henrique, aluna do fluent speech", quote: "“Acho que nunca entendi e aprendi o inglês como agora. De forma clara, simples e esclarecedora. A quebra da vergonha de falar o inglês, a Nájila te deixa mais à vontade, e te torna mais confiante.”", pos: "50% 70%" },
  { name: "Sofia Barros", role: "Aluna do Fluent Speech", img: "depoimentos/sofia-barros", size: 360, alt: "Foto de Sofia Barros, aluna do fluent speech", quote: "“Com a Nájila as aulas são sempre divertidas com materiais diversificados, além dela ser dedicada, está sempre atualizando o material.”", pos: "50% 15%" },
  { name: "Bianca Almeida", role: "Aluna do Fluent Speech", img: "depoimentos/bianca-almeida", size: 360, alt: "Foto de Bianca Almeida, aluna do fluent speech", quote: "“Obrigada por me ensinar coisas que eu achei que nunca conseguiria compreender, sua didática de conversação é estimulante para o meu aprendizado. Sou muito grata pela sua paciência, motivação e alegria.”", pos: "60% 25%" },
  { name: "Bruna Fogarolli", role: "Aluna do Fluent Speech", img: "depoimentos/bruna-fogarolli", size: 360, alt: "Foto de Bruna Fogarolli, aluna do fluent speech", quote: "“Eu gostaria de agradecer a paciência que tem em me ensinar e não desistir de mim. Jamais pensei ser possível amar inglês, mas com o seu método e toda a sua didática, isso mudou completamente.”" },
  { name: "Ryan Dionisio", role: "Aluno do Fluent Speech", img: "depoimentos/ryan-dionisio", size: 360, alt: "Foto de Ryan Dionisio, aluno do fluent speech", quote: "“As aulas da teacher me ajudam muito porque, às vezes, fico brincando com meus amigos falando inglês, e antes um deles falava e eu não entendia nada. Hoje sou eu que falo e eles não entendem nada.”", pos: "50% 30%" },
  { name: "Virlene Carneiro", role: "Aluna do Fluent Speech", img: "depoimentos/virlene-carneiro", size: 360, alt: "Foto de Virlene Carneiro, aluna do fluent speech", quote: "“Procurei um curso de inglês de qualidade e consegui encontrar. Estou amando fazer as aulas com você, tenho certeza de que com a sua ajuda vou conseguir falar inglês. Obrigada por tanto!”" },
  { name: "Glicinia Ferreira", role: "Aluna do Fluent Speech", img: "depoimentos/glicinia-ferreira", size: 360, alt: "Foto de Glicinia Ferreira, aluna do fluent speech", quote: "“O que sempre me encanta é sua paciência, carinho e total profissionalismo. Única aula da vida que faço feliz às 8h da manhã e vejo surtir efeito.”" },
  { name: "Vinicius Dionisio", role: "Aluno do Fluent Speech", img: "depoimentos/vinicius-dionisio", size: 360, alt: "Foto de Vinicius Dionisio, aluno do fluent speech", quote: "“Nunca encontrei um curso onde eu conseguisse acompanhar a didática e alcançar a conversação em inglês. Somente com a Nájila consegui encontrar a verdadeira arte de aprender de forma descomplicada e disruptiva.”", pos: "65% 35%" },
  { name: "Willian Afonso", role: "Aluno do Fluent Speech", img: "depoimentos/willian-afonso", size: 360, alt: "Foto de Willian Afonso, aluno do fluent speech", quote: "“Melhor professora que já vi!!! Super compreensiva e desembaraçada. Ótima didática, mesmo considerando que cada um tem a sua, ela supera expectativas personalizando cada aula e conteúdo para incentivar e melhorar os resultados dos alunos! Já fui aluno e voltei a ser!”" },
];
---
<section id="depoimentos" class="atmos-ice blend-top-light blend-bottom-dark relative overflow-hidden px-5 py-24 lg:px-8 lg:py-32"><div aria-hidden="true" class="aurora aurora-electric aurora-drift-a -left-32 top-0 size-[30rem] opacity-[0.10]"></div><div aria-hidden="true" class="aurora aurora-electric aurora-drift-b -right-24 bottom-0 size-[26rem] opacity-[0.14]"></div><div aria-hidden="true" class="aurora aurora-electric left-1/2 top-1/2 size-[42rem] -translate-x-1/2 -translate-y-1/2 opacity-[0.12]"></div><div class="relative mx-auto max-w-6xl"><div class="reveal" data-visible="false" style="transition-delay:0ms"><div class="flex flex-col gap-4 items-center text-center mx-auto max-w-3xl"><h2 class="text-balance text-3xl leading-[1.18] sm:text-4xl lg:text-[2.9rem] text-foreground font-medium">Quem criou o Fluent Speech <em class="text-primary font-medium">já ensina inglês há anos.</em></h2><p class="max-w-2xl text-balance text-base leading-relaxed sm:text-lg text-muted-foreground font-semibold">Veja o que dizem os alunos das aulas da Royal English, a escola por trás do método.</p></div></div></div><div class="relative -mx-5 mt-14 cursor-grab select-none pb-6 pt-4 [touch-action:pan-y] lg:-mx-8" data-slides role="region" aria-label="Depoimentos de alunos"><div class="relative flex items-center">{items.map((d, i) => (<article data-slide class="relative mr-5 w-[min(82vw,24rem)] shrink-0 origin-left will-change-transform lg:mr-8" style={i === 0 ? 'margin-left:5vw' : undefined}><figure class={`relative flex flex-col overflow-hidden rounded-3xl border border-on-navy/15 p-7 text-on-navy shadow-[0_24px_60px_-30px_rgb(7_21_37/0.55)] sm:p-9 ${bg[i % 4]}`}><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute right-5 top-4 size-24 text-on-navy/12" aria-hidden="true"><path d="M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path><path d="M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"></path></svg><figcaption class="relative flex min-w-0 items-center gap-4"><img src={`/images/${d.img}.jpg`} width={d.size} height={d.size} alt={d.alt} style={d.pos ? `object-position:${d.pos}` : undefined} draggable="false" loading="lazy" class="size-16 shrink-0 rounded-full object-cover object-center ring-2 ring-on-navy/40 shadow-[0_8px_24px_-10px_oklch(0_0_0/0.6)] sm:size-[4.5rem]" decoding="async" /><span class="min-w-0"><span class="block truncate font-display text-xl font-semibold">{d.name}</span><span class="block truncate text-xs lg:text-[0.7rem] uppercase tracking-[0.16em] text-on-navy/80 font-label font-medium">{d.role}</span></span></figcaption><blockquote class="relative mt-7 font-serif text-[1.15rem] font-normal italic leading-[1.55] text-on-navy/90">{d.quote}</blockquote></figure></article>))}</div></div></section>