---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
const { title, description, updated } = Astro.props;
const docs = [
  ['Política de Privacidade', '/politica-de-privacidade'],
  ['Termos de Uso', '/termos-de-uso'],
  ['Política de Cookies', '/politica-de-cookies'],
];
const here = Astro.url.pathname.replace(/\/$/, '');
---
<Layout title={`${title} | Royal English`} description={description} legal>
  <header class="bg-navy-ink">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 lg:px-8">
      <a href="/" class="flex min-w-0 items-center gap-2.5"><img src="/images/logo-royal-english.webp" alt="" width="127" height="128" class="size-12 shrink-0 object-contain" /><span class="truncate uppercase text-on-navy font-wordmark text-lg font-bold tracking-[0.2em]">Royal English</span></a>
      <a href="/" aria-label="Voltar ao site" class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-end whitespace-nowrap text-sm text-on-navy-muted transition-colors hover:text-on-navy">← <span class="max-sm:sr-only">&nbsp;Voltar ao site</span></a>
    </div>
  </header>
  <main data-legal class="atmos-ice px-5 py-12 lg:px-8 lg:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
      <nav aria-label="Documentos legais" class="lg:sticky lg:top-8 lg:self-start">
        <span class="block font-label text-xs uppercase tracking-[0.2em] text-gold-ink">Documentos legais</span>
        <ul class="mt-3 flex flex-col border-l border-navy/15">
          {docs.map(([label, href]) => (
            <li>
              <a href={href} aria-current={href === here ? 'page' : undefined} class="-ml-px block min-h-11 border-l-2 border-transparent py-2.5 pl-4 text-sm text-navy-deep/80 transition-colors hover:text-navy aria-[current=page]:border-gold-ink aria-[current=page]:font-semibold aria-[current=page]:text-navy">{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <article class="legal max-w-3xl text-navy-deep">
        <h1 class="text-balance text-4xl font-medium leading-tight text-navy lg:text-5xl">{title}</h1>
        <p class="lead mt-3 font-label text-xs uppercase tracking-[0.18em] text-gold-ink">Última revisão: {updated}</p>
        <slot />
      </article>
    </div>
  </main>
  <Footer />
</Layout>
<style is:global>
  .legal{counter-reset:sec}
  .legal h2{counter-increment:sec;counter-reset:sub;margin-top:2.75rem;font-family:var(--font-display);font-size:.95rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.3;color:var(--color-navy)}
  .legal h2::before{content:counter(sec) ". "}
  .legal li{margin-top:.4rem}
  .legal p{margin-top:.9rem;font-size:1rem;line-height:1.75}
  .legal p,.legal li{font-size:1rem;line-height:1.75}
  .legal p.lead{font-size:.75rem;line-height:1.4}
  .legal h2 ~ p{counter-increment:sub}
  .legal h2 ~ p::before{content:counter(sec) "." counter(sub);margin-right:.6rem;font-weight:700;color:var(--color-gold-ink)}
  .legal ul{margin-top:.5rem;padding-left:1.25rem;list-style:disc}
  .legal a{color:var(--color-gold-ink);text-decoration:underline;text-underline-offset:3px}
  .legal strong{font-weight:600}
</style>
